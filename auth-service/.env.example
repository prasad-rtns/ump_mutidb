# ─── Service ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=6001
SERVICE_NAME=auth-service
LOG_LEVEL=debug
LOG_DIR=./logs
HOST=0.0.0.0
AUTH_PROVIDER=local
ALLOW_LOCAL_AUTH_FALLBACK=false

# ─── Default DB ───────────────────────────────────────────────────────────────
DEFAULT_DB_TYPE=postgres

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ump_auth
POSTGRES_USER=ump_user
POSTGRES_PASSWORD=ump_pass_2024
POSTGRES_SSL=false

# ─── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ump_auth
MYSQL_USER=ump_user
MYSQL_PASSWORD=ump_pass_2024

# ─── MSSQL ────────────────────────────────────────────────────────────────────
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_DB=ump_auth
MSSQL_USER=sa
MSSQL_PASSWORD=Ump_Pass@2024

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=ump_auth
MONGO_USER=ump_user
MONGO_PASSWORD=ump_pass_2024

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_pass_2024@redis:6379
REDIS_PASSWORD=redis_pass_2024
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secure_access_secret_min_32_chars_change_in_prod
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_min_32_chars_change_in_prod
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:6000,http://localhost:6001
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# ─── Email (for password reset / verification) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=prasad.rtns@email.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@ump-platform.com

# ─── AWS S3 (optional) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=ump-documents

# ─── Master Service URL ────────────────────────────────────────────────────────
MASTER_SERVICE_URL=http://master-service:6002

# ─── MSSQL Trust Cert (set true for local/self-signed, false for Azure prod) ──
MSSQL_TRUST_CERT=true

# ─── Oracle ───────────────────────────────────────────────────────────────────
ORACLE_USER=ump_user
ORACLE_PASSWORD=ump_pass_2024
ORACLE_HOST=oracle
ORACLE_PORT=1521
ORACLE_SID=XE
# OR use a full connection string (takes precedence if set):
# ORACLE_CONN_STR=oracle:1521/XE
WSO2_BASE_URL=https://wso2-apim:9443
WSO2_SCIM_BASE_PATH=/scim2
WSO2_ADMIN_USERNAME=admin
WSO2_ADMIN_PASSWORD=admin
WSO2_SCIM_ACCESS_TOKEN=
WSO2_OAUTH_CLIENT_ID=
WSO2_OAUTH_CLIENT_SECRET=
WSO2_TOKEN_URL=https://wso2-apim:9443/oauth2/token
WSO2_VERIFY_TLS=false
