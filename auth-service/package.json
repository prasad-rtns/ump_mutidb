{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication & User Management Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:pg": "drizzle-kit push --config=drizzle.pg.config.ts",
    "migrate:mysql": "drizzle-kit push --config=drizzle.mysql.config.ts",
    "migrate:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
