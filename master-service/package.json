{
  "name": "master-service",
  "version": "1.0.0",
  "description": "Master Data Management Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate:pg": "drizzle-kit push --config=drizzle.pg.config.ts",
    "migrate:mysql": "drizzle-kit push --config=drizzle.mysql.config.ts",
    "migrate:mssql": "node ../scripts/run-mssql-migrations.js --dir ./src/database/migrations/mssql",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prasad-rtns/shared": "^1.0.1",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "eslint": "10.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "morgan": "^1.10.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.18.1",
    "opossum": "^9.0.0",
    "oracledb": "^6.10.0",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "redis": "^4.6.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.9",
    "@types/node": "^20.10.0",
    "@types/opossum": "^8.1.9",
    "@types/oracledb": "^6.10.1",
    "@types/pg": "^8.10.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.31.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
